@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(GARAZYK_INCLUDE_SOURCES "${PACKAGE_PREFIX_DIR}/@GARAZYK_INSTALL_INCLUDEDIR@/garazyk/Sources")
set(GARAZYK_INCLUDE_FRAMEWORKS "${PACKAGE_PREFIX_DIR}/@GARAZYK_INSTALL_INCLUDEDIR@/garazyk/Frameworks")

find_dependency(ZLIB)

# Recreate the ZSTD::zstd imported target expected by Garazyk::ATProtoTransport.
find_path(ZSTD_INCLUDE_DIR NAMES zstd.h
  HINTS ENV ZSTD_ROOT PATH_SUFFIXES include
  PATHS /opt/homebrew/opt/zstd/include /usr/local/opt/zstd/include /usr/include)
find_library(ZSTD_LIBRARY NAMES zstd
  HINTS ENV ZSTD_ROOT PATH_SUFFIXES lib
  PATHS /opt/homebrew/opt/zstd/lib /usr/local/opt/zstd/lib /usr/lib /usr/lib/x86_64-linux-gnu)
if(NOT ZSTD_INCLUDE_DIR OR NOT ZSTD_LIBRARY)
  set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
    "Garazyk requires libzstd (set ZSTD_ROOT or install zstd / libzstd-dev)")
  set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
  return()
endif()
if(NOT TARGET ZSTD::zstd)
  add_library(ZSTD::zstd UNKNOWN IMPORTED)
  set_target_properties(ZSTD::zstd PROPERTIES
    IMPORTED_LOCATION "${ZSTD_LIBRARY}"
    INTERFACE_INCLUDE_DIRECTORIES "${ZSTD_INCLUDE_DIR}")
endif()

if(@GARAZYK_WITH_OPENSSL@)
  find_dependency(OpenSSL)
endif()

if(APPLE)
  find_library(GARAZYK_Foundation Foundation REQUIRED)
  find_library(GARAZYK_Security Security REQUIRED)
  find_library(GARAZYK_LocalAuthentication LocalAuthentication REQUIRED)
  find_library(GARAZYK_SQLite3 sqlite3 REQUIRED)
  find_library(GARAZYK_Resolv resolv REQUIRED)
  find_library(GARAZYK_Network Network REQUIRED)
  set(GARAZYK_PLATFORM_LIBS
    ${GARAZYK_Foundation}
    ${GARAZYK_Security}
    ${GARAZYK_LocalAuthentication}
    ${GARAZYK_SQLite3}
    ${GARAZYK_Resolv}
    ${GARAZYK_Network})
  if(@GARAZYK_WITH_OPENSSL@ AND OpenSSL_FOUND)
    list(APPEND GARAZYK_PLATFORM_LIBS OpenSSL::Crypto)
  endif()
else()
  if(NOT @GARAZYK_WITH_OPENSSL@)
    find_dependency(OpenSSL REQUIRED)
  endif()
  find_library(GARAZYK_SQLite3 sqlite3 REQUIRED)

  # Relocatable consumers need GNUstep Foundation headers/libs; CMake cannot
  # export absolute host include paths through GarazykTargets.cmake reliably.
  if(DEFINED ENV{GNUSTEP_PREFIX} AND NOT "$ENV{GNUSTEP_PREFIX}" STREQUAL "")
    set(_gz_gnustep_prefix "$ENV{GNUSTEP_PREFIX}")
  else()
    set(_gz_gnustep_prefix "/usr/GNUstep/Local")
  endif()
  find_path(GARAZYK_GNUSTEP_FOUNDATION_INCLUDE_DIR
    Foundation/Foundation.h
    HINTS "${_gz_gnustep_prefix}/Library/Headers" "${_gz_gnustep_prefix}/include"
    PATHS /usr/include/GNUstep /usr/local/include/GNUstep)
  find_library(GARAZYK_GNUSTEP_BASE NAMES gnustep-base
    HINTS "${_gz_gnustep_prefix}/Library/Libraries" "${_gz_gnustep_prefix}/lib"
    PATHS /usr/lib /usr/local/lib)
  find_library(GARAZYK_OBJC NAMES objc-2 objc
    HINTS "${_gz_gnustep_prefix}/Library/Libraries" "${_gz_gnustep_prefix}/lib"
    PATHS /usr/lib /usr/local/lib)
  find_library(GARAZYK_DISPATCH NAMES dispatch
    HINTS "${_gz_gnustep_prefix}/Library/Libraries" "${_gz_gnustep_prefix}/lib"
    PATHS /usr/lib /usr/local/lib)
  if(NOT GARAZYK_GNUSTEP_FOUNDATION_INCLUDE_DIR OR NOT GARAZYK_GNUSTEP_BASE OR NOT GARAZYK_OBJC)
    set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
      "Garazyk on Linux requires GNUstep Foundation (set GNUSTEP_PREFIX)")
    set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
    return()
  endif()
  set(GARAZYK_PLATFORM_LIBS
    ${GARAZYK_GNUSTEP_BASE}
    ${GARAZYK_OBJC}
    OpenSSL::SSL OpenSSL::Crypto
    ${GARAZYK_SQLite3}
    pthread m dl resolv)
  if(GARAZYK_DISPATCH)
    list(APPEND GARAZYK_PLATFORM_LIBS ${GARAZYK_DISPATCH})
  endif()
  set(GARAZYK_GNUSTEP_COMPILE_OPTIONS
    -fobjc-arc -fblocks -fobjc-runtime=gnustep-2.2)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/GarazykTargets.cmake")

set(Garazyk_ATProtoCore_FOUND TRUE)
set(Garazyk_ATProtoStorage_FOUND TRUE)
set(Garazyk_ATProtoTransport_FOUND TRUE)
set(Garazyk_ATProtoServices_FOUND TRUE)
set(Garazyk_ATProtoXRPC_FOUND TRUE)
set(Garazyk_ATProtoSync_FOUND TRUE)
set(Garazyk_ATProtoPLC_FOUND TRUE)
set(Garazyk_ATProtoRuntime_FOUND TRUE)
set(Garazyk_ATProtoMediaCore_FOUND TRUE)
set(Garazyk_ATProtoVideoService_FOUND TRUE)
set(Garazyk_ATProtoAdminUI_FOUND TRUE)

# Installed consumers need the same two-root include layout as the build tree.
foreach(_gz_target IN ITEMS
    ATProtoCore ATProtoStorage ATProtoTransport ATProtoServices ATProtoXRPC
    ATProtoSync ATProtoPLC ATProtoRuntime ATProtoMediaCore ATProtoVideoService)
  if(TARGET Garazyk::${_gz_target})
    set(_gz_includes
      "${GARAZYK_INCLUDE_SOURCES};${GARAZYK_INCLUDE_FRAMEWORKS}")
    if(NOT APPLE AND GARAZYK_GNUSTEP_FOUNDATION_INCLUDE_DIR)
      set(_gz_includes
        "${_gz_includes};${GARAZYK_GNUSTEP_FOUNDATION_INCLUDE_DIR}")
      # libobjc2 headers (objc/blocks_runtime.h) live under GNUSTEP_PREFIX/include.
      if(EXISTS "${_gz_gnustep_prefix}/include/objc/blocks_runtime.h")
        set(_gz_includes "${_gz_includes};${_gz_gnustep_prefix}/include")
      endif()
    endif()
    set_target_properties(Garazyk::${_gz_target} PROPERTIES
      INTERFACE_INCLUDE_DIRECTORIES "${_gz_includes}")
    target_link_libraries(Garazyk::${_gz_target} INTERFACE ${GARAZYK_PLATFORM_LIBS})
    if(NOT APPLE AND GARAZYK_GNUSTEP_COMPILE_OPTIONS)
      target_compile_options(Garazyk::${_gz_target} INTERFACE
        ${GARAZYK_GNUSTEP_COMPILE_OPTIONS})
    endif()
  endif()
endforeach()

if(APPLE AND TARGET Garazyk::ATProtoRuntime)
  find_library(GARAZYK_Readline readline)
  find_library(GARAZYK_AppKit AppKit REQUIRED)
  set(_gz_runtime_extra ${GARAZYK_AppKit})
  if(GARAZYK_Readline)
    list(APPEND _gz_runtime_extra ${GARAZYK_Readline})
  endif()
  target_link_libraries(Garazyk::ATProtoRuntime INTERFACE ${_gz_runtime_extra})
endif()

# Frameworks cannot be exported as "-framework Foo" through CMake's target export
# (the flag is split into a bare library name). Reattach them here instead.
if(APPLE)
  if(TARGET Garazyk::ATProtoServices)
    target_link_libraries(Garazyk::ATProtoServices INTERFACE
      "-framework CoreMedia" "-framework AVFoundation")
  endif()
  if(TARGET Garazyk::ATProtoVideoService)
    target_link_libraries(Garazyk::ATProtoVideoService INTERFACE
      "-framework CoreMedia" "-framework AVFoundation"
      "-framework ImageIO" "-framework CoreServices")
  endif()
  if(TARGET Garazyk::ATProtoMediaCore)
    target_link_libraries(Garazyk::ATProtoMediaCore INTERFACE
      "-framework Foundation")
  endif()
endif()

check_required_components(Garazyk)
