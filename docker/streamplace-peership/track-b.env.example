# Opt-in only: source this after .env when using docker-compose.track-b.yml.
#
# The source revision is deliberately fixed.  Scenario 101 also inspects the
# running image's OCI revision label and skips rather than treating an
# unproven image (including the general lab's OCI pin) as Track B evidence.
STREAMPLACE_TRACK_B_SOURCE_REVISION=5ba597dbedda8f2fdb84b815ee633301212f5f51
STREAMPLACE_TRACK_B_IMAGE=
STREAMPLACE_TRACK_B_PUBLISHER_IMAGE=
JELCZ_STREAMPLACE_TRACK_B_BRIDGE_IMAGE=
STREAMPLACE_TRACK_B_BRIDGE_TOKEN=

# Supply the DID actually used by the pinned Streamplace publisher.  This is
# both the firehose/origin target and the explicit bridge consent allow-list.
STREAMPLACE_TRACK_B_STREAMER_DID=
STREAMPLACE_TRACK_B_BROADCASTER_DID=
STREAMPLACE_TRACK_B_STREAM_KEY=garazyk-track-b
STREAMPLACE_TRACK_B_RELAY_HOST=ws://local-relay:2584/xrpc/com.atproto.sync.subscribeRepos
# Scenario 101 consumes the relay from the host, not through Compose DNS.
# This must be the exact subscribeRepos endpoint (including /xrpc/...).
STREAMPLACE_TRACK_B_HOST_FIREHOSE_URL=ws://127.0.0.1:2584/xrpc/com.atproto.sync.subscribeRepos
# Jelcz's host-published mutation API and its separate capability. Do not put
# a production value in this example or commit either token to artifacts.
JELCZ_TRACK_B_HOST_URL=http://127.0.0.1:2596
JELCZ_TRACK_B_API_TOKEN=
STREAMPLACE_TRACK_B_MAX_SEGMENT_BYTES=8388608
STREAMPLACE_TRACK_B_MAX_RECONNECTS=3
