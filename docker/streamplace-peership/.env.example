# Copy to .env next to docker-compose.yml. The wrapper scripts and manual
# Compose commands both use this exact file with --env-file.
#
# Streamplace is pinned to a tested digest below. The optional FFmpeg publish
# profile intentionally requires a separate explicit tested reference. The
# compose file never falls back to `latest`.

# Persistent, operator-facing demo state. For a clean acceptance run, use
# streamplace_peership_up.sh --fresh (or set a unique project name yourself).
COMPOSE_PROJECT_NAME=streamplace-peership-demo

# Published host ports bind locally by default. LAB_PUBLIC_HOST is the hostname
# placed into browser-facing URLs; it is not used for container-to-container IO.
LAB_BIND_ADDRESS=127.0.0.1
LAB_PUBLIC_HOST=127.0.0.1

# Docker network created by docker/local-network compose project
GARAZYK_ATPROTO_NET=local-network_local_net

# Tested locally for this lab on 2026-08-13. Keep a digest, rather than a
# mutable tag, so a normal lab run is reproducible.
STREAMPLACE_IMAGE=oci.stream.place/streamplace@sha256:d2b79900b03eb6a964961bc9df0423492ea8b83602f7d3c2f4b7c7a66dbf8776
# The publish profile requires an explicit tested immutable reference. Left
# blank so normal config, status, and non-publish runs have no FFmpeg dependency.
FFMPEG_IMAGE=
STREAMPLACE_HTTP_HOST_PORT=38080
STREAMPLACE_HTTP_LISTEN_PORT=38080
STREAMPLACE_RTMP_HOST_PORT=1935
STREAMPLACE_RTMP_LISTEN_PORT=1935
STREAMPLACE_TEST_STREAM=true
# Lab-only authentication bypass. Keep true only for an isolated local lab;
# set false and configure Streamplace access controls for any shared deployment.
STREAMPLACE_WIDE_OPEN=true
STREAMPLACE_NO_FIREHOSE=true
STREAMPLACE_ATTRIBUTION_DID=did:web:stream.place

JELCZ_PEER_IMAGE=garazyk/jelcz-peer:local
JELCZ_A_HOST_PORT=2596
JELCZ_A_LISTEN_PORT=2596
JELCZ_B_HOST_PORT=2597
JELCZ_B_LISTEN_PORT=2597
JELCZ_C_HOST_PORT=2598
JELCZ_C_LISTEN_PORT=2598
IROH_SIDECAR_PORT=17352
IROH_SIDECAR_IMAGE=garazyk/jelcz-iroh-sidecar:local

# Leave blank. The startup wrapper creates a random per-project capability in
# its ignored 0600 runtime env file; manual Compose users must set one.
JELCZ_IROH_SIDECAR_CAPABILITY=

# Optional fixed token. When blank, `streamplace_peership_up.sh` creates a
# cryptographically random token in a project-specific ignored runtime env file.
JELCZ_DEMO_API_TOKEN=

# Optional Docker-PDS origin-publication acceptance path. The federation smoke
# supplies disposable credentials at runtime; keep these blank/off for normal
# peership runs and never commit a real app password.
JELCZ_ORIGIN_ANNOUNCE=0
JELCZ_ORIGIN_ANNOUNCE_IDENTIFIER=
JELCZ_ORIGIN_ANNOUNCE_APP_PASSWORD=
JELCZ_ORIGIN_ANNOUNCE_PDS_URL=http://local-pds:2583
JELCZ_ORIGIN_ANNOUNCE_SERVER_DID=
JELCZ_ORIGIN_ANNOUNCE_HTTPS_BASE=

# Consent for origin-record auto-ingest (empty = deny). Env peer lists always apply.
JELCZ_P2P_ALLOWED_STREAMERS=
JELCZ_P2P_ALLOWED_BROADCASTERS=
