{
  "id": "app.offprint.actor.profile",
  "defs": {
    "main": {
      "key": "self",
      "type": "record",
      "record": {
        "type": "object",
        "properties": {
          "avatar": {
            "type": "blob",
            "accept": [
              "image/png",
              "image/jpeg"
            ],
            "maxSize": 1000000,
            "description": "Small image to be displayed next to the user's content. AKA, 'profile picture'."
          },
          "banner": {
            "type": "blob",
            "accept": [
              "image/png",
              "image/jpeg"
            ],
            "maxSize": 1000000,
            "description": "Larger horizontal image to display behind the profile view."
          },
          "website": {
            "type": "string",
            "format": "uri",
            "description": "Personal website URL."
          },
          "pronouns": {
            "type": "string",
            "maxLength": 200,
            "description": "Free-form pronouns text.",
            "maxGraphemes": 20
          },
          "createdAt": {
            "type": "string",
            "format": "datetime",
            "description": "Timestamp of when the profile was created."
          },
          "description": {
            "type": "string",
            "maxLength": 2560,
            "description": "Free-form profile description text.",
            "maxGraphemes": 256
          },
          "displayName": {
            "type": "string",
            "maxLength": 640,
            "description": "Display name for the user on Offprint.",
            "maxGraphemes": 64
          }
        }
      },
      "description": "A declaration of an Offprint user profile. Overrides the Bluesky profile when set."
    }
  },
  "lexicon": 1
}
