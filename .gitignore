# OpenCode — local caches only (project skills/plans are committed)
.opencode/node_modules/
.opencode/package-lock.json
.opencode/bun.lock

# Pi — agent extensions (local tooling)
.pi/

# Playwright MCP — session snapshots
.playwright-mcp/

# Letta — agent memory
.letta/

# Agent scratch directories (ephemeral session output)
.scratch/
.scratchpad/
scratchpads/
.agents/scratchpad/

